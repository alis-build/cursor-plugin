{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "command": "./check-cli.sh"
      },
      {
        "command": "./inject-service-context.sh",
        "type": "command"
      },
      {
        "command": "./sync-skills.sh",
        "type": "command"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "./allow-alis-cli.sh",
        "type": "command"
      }
    ],
    "postToolUse": [
      {
        "command": "./post-tool-use.sh",
        "type": "command"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "./suggest-skills.sh",
        "type": "command",
        "timeout": 5
      }
    ]
  }
}
